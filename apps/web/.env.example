# Public URL of the api, used by the browser (baked in at build time).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# URL the Next.js server uses to reach the api (server-side fetches, admin dashboard).
INTERNAL_BACKEND_URL=http://localhost:8000

# Must equal the api's DASHBOARD_SECRET (server-side web → api calls; never sent to browsers).
DASHBOARD_SECRET=

# Admin login at /login. Hash a password with: bun scripts/hash-admin-password.ts '<password>'
ADMIN_PASSWORD_HASH=
# Signs the admin session cookie (32+ chars; changing it logs everyone out). openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Must equal the api's VAPID_PUBLIC_KEY (push alerts).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
