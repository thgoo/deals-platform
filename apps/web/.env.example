# Public URL of the api, used by the browser (baked in at build time).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# URL the Next.js server uses to reach the api (server-side fetches, admin dashboard).
INTERNAL_BACKEND_URL=http://localhost:8000

# Must equal the api's DASHBOARD_SECRET. Also the admin URL slug: /<secret>/admin
DASHBOARD_SECRET=

# Must equal the messaging service's VAPID_PUBLIC_KEY (push alerts).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
