# ════════════════════════════════════════════════════════════════════════════
# core-api — main HTTP API for bargah.com.br
#
# Receives deals from telegram-crawler, persists them, runs AI extraction
# (via ai-service), affiliate rewriting (link-pipeline), and product resolution.
# Required keys are marked [REQUIRED].
# ════════════════════════════════════════════════════════════════════════════

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development                  # development | production | test
PORT=8000
LOG_LEVEL=debug                       # debug | info | warn | error

# ─── Database [REQUIRED] ────────────────────────────────────────────────────
# PostgreSQL 18+ with pgvector. Format: postgres://user:password@host:port/database
DATABASE_URL="postgres://deals:deals@localhost:5432/deals"

# ─── Secrets [REQUIRED] ─────────────────────────────────────────────────────
SESSION_SECRET="change-me-at-least-32-characters-long-please"
WEBHOOK_SECRET="change-me-min-8-chars"
# Gate for /api/dashboard/* — also used as the URL slug in client-web.
# Generate one with: openssl rand -hex 16
DASHBOARD_SECRET="change-me-min-16-chars-random-hex"

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the browser client.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ─── Web Push (keyword alerts) [REQUIRED] ────────────────────────────────────
# Generate with: bunx web-push generate-vapid-keys
# The public key must also be set as NEXT_PUBLIC_VAPID_PUBLIC_KEY in web.
VAPID_EMAIL=you@email.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── AI (extraction, embeddings, match judge) ───────────────────────────────
# Extraction and the match judge use LLM_PROVIDER; embeddings always use OpenAI.
LLM_PROVIDER=abacus                   # abacus | openai

# Abacus (RouteLLM proxy) — [REQUIRED if LLM_PROVIDER=abacus]
ABACUS_API_KEY=
ABACUS_MODEL=claude-3-7-sonnet-20250219
ABACUS_BASE_URL=https://routellm.abacus.ai/v1/chat/completions
ABACUS_TIMEOUT_MS=30000

# OpenAI — [REQUIRED] for embeddings; also the LLM when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4.1-nano
OPENAI_LLM_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_LLM_TIMEOUT_MS=30000
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1/embeddings
OPENAI_EMBEDDING_TIMEOUT_MS=30000

# ─── Affiliate programs ─────────────────────────────────────────────────────
# All optional. If a credential is absent, that store's rewriter becomes a
# no-op — links are still extracted and matched, just not affiliate-tagged.
AMAZON_AFFILIATE_TAG=
MERCADOLIVRE_AFFILIATE_ID=
NATURA_AFFILIATE_ID=
MAGALU_AFFILIATE_ID=
MAGALU_PROMOTER_ID=
SHOPEE_APP_ID=
SHOPEE_SECRET=
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
AWIN_PUBLISHER_ID=
AWIN_TOKEN=
