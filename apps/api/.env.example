# Environment
NODE_ENV=development
PORT=8000

# Database — mysql://user:password@host:port/database
DATABASE_URL="mysql://root:password@localhost:3306/bargah"

# Secrets
SESSION_SECRET="a-very-strong-and-super-secret-key-of-at-least-32-chars"
WEBHOOK_SECRET="webhook-secret-min-8-chars"

# CORS — comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Internal services
MESSAGING_SERVICE_URL="http://localhost:3002"
