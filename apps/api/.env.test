# Loaded automatically by `bun test` (NODE_ENV=test). Dummy values only — tests never touch a real DB or service.
DATABASE_URL=postgres://test:test@127.0.0.1:5432/test
WEBHOOK_SECRET=test-webhook-secret
DASHBOARD_SECRET=test-dashboard-secret
LOG_LEVEL=error
VAPID_EMAIL=test@example.com
VAPID_PUBLIC_KEY=test-public-key
VAPID_PRIVATE_KEY=test-private-key
# Blank on purpose: overrides real keys from a developer's .env, so no test ever calls a provider.
OPENAI_API_KEY=
ABACUS_API_KEY=
